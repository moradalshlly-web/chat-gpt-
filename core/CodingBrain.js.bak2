export class CodingBrain {
  constructor({
    registry,
    planner,
    execution
  }) {
    this.registry = registry;
    this.planner = planner;
    this.execution = execution;

    this.version = "1.0.0";
  }

  normalizeTask(prompt) {
    return String(prompt || "")
      .trim()
      .replace(/\s+/g, " ");
  }

  classifyTask(task) {
    const text = task.toLowerCase();

    if (
      /اقرأ|اقري|read|show|اعرض/.test(text)
    ) {
      return "READ";
    }

    if (
      /ابحث|بحث|search|find|وين موجود/.test(text)
    ) {
      return "SEARCH";
    }

    if (
      /اختبر|اختبار|test|check/.test(text)
    ) {
      return "TEST";
    }

    if (
      /اصلح|أصلح|صلح|خطأ|غلط|error|bug|debug/.test(text)
    ) {
      return "DEBUG";
    }

    if (
      /عدل|عدّل|غير|غيّر|طور|طوّر|حسن|حسّن|fix|edit|modify|implement/.test(text)
    ) {
      return "MODIFY";
    }

    if (
      /أنشئ|انشئ|إنشاء|create|build|make/.test(text)
    ) {
      return "CREATE";
    }

    return "ANALYZE";
  }

  extractFiles(task) {
    const matches =
      task.match(
        /(?:[\w.-]+\/)*[\w.-]+\.(?:js|mjs|cjs|ts|tsx|jsx|json|py|java|kt|go|rs|cpp|c|html|css|md|yml|yaml|sh)/gi
      ) || [];

    return [...new Set(matches)];
  }

  async inspectRepository() {
    return await this.registry.execute(
      "repository_map"
    );
  }

  async inspectFiles(files = []) {
    const results = [];

    for (const file of files) {
      try {
        const exists =
          await this.registry.execute(
            "file_exists",
            file
          );

        if (!exists) {
          results.push({
            file,
            exists: false
          });
          continue;
        }

        const content =
          await this.registry.execute(
            "read_file",
            file
          );

        results.push({
          file,
          exists: true,
          size: String(content).length
        });
      } catch (error) {
        results.push({
          file,
          exists: false,
          error: error.message
        });
      }
    }

    return results;
  }

  buildStrategy(task, intent, files) {
    const strategy = {
      intent,
      files,
      stages: []
    };

    strategy.stages.push("UNDERSTAND");
    strategy.stages.push("INSPECT");

    if (
      intent === "CREATE" ||
      intent === "MODIFY" ||
      intent === "DEBUG"
    ) {
      strategy.stages.push("ANALYZE_DEPENDENCIES");
      strategy.stages.push("PLAN_CHANGE");
      strategy.stages.push("IMPLEMENT");
      strategy.stages.push("VERIFY");
    }

    if (intent === "READ") {
      strategy.stages.push("READ");
    }

    if (intent === "SEARCH") {
      strategy.stages.push("SEARCH");
    }

    if (intent === "TEST") {
      strategy.stages.push("VERIFY");
    }

    strategy.stages.push("FINAL_REVIEW");

    return strategy;
  }

  async analyze(prompt) {
    const task = this.normalizeTask(prompt);

    if (!task) {
      throw new Error("EMPTY_TASK");
    }

    const intent = this.classifyTask(task);
    const files = this.extractFiles(task);

    const repository =
      await this.inspectRepository();

    const inspectedFiles =
      await this.inspectFiles(files);

    const strategy =
      this.buildStrategy(
        task,
        intent,
        files
      );

    return {
      version: this.version,
      task,
      intent,
      files,
      repository: {
        totalFiles:
          repository.totalFiles,
        totalDirectories:
          repository.totalDirectories
      },
      inspectedFiles,
      strategy
    };
  }

  async think(prompt) {
    const analysis =
      await this.analyze(prompt);

    const plan =
      this.planner.createPlan(
        analysis.task
      );

    return {
      analysis,
      plan,
      decision: {
        ready:
          Array.isArray(plan) &&
          plan.length > 0,
        reason:
          "Task analyzed and execution strategy prepared."
      }
    };
  }
}
