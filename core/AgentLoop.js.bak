export class AgentLoop {
  constructor({
    agent,
    registry,
    planner,
    execution,
    verification
  }) {
    this.agent = agent;
    this.registry = registry;
    this.planner = planner;
    this.execution = execution;
    this.verification = verification;

    this.maxSteps =
      agent.config.maxAgentSteps || 5;

    this.state = this.createInitialState();
  }

  createInitialState() {
    return {
      status: "idle",
      task: null,
      plan: [],
      repository: null,
      observations: [],
      execution: null,
      verification: null,
      result: null
    };
  }

  async inspect() {
    const repository =
      await this.registry.execute(
        "repository_map"
      );

    this.state.repository = repository;

    this.state.observations.push({
      step: "INSPECT",
      message:
        `Repository contains ${repository.totalFiles} files and ${repository.totalDirectories} directories.`
    });

    return repository;
  }

  async createPlan(task) {
    const plan =
      this.planner.createPlan(task);

    this.state.plan = plan;

    this.state.observations.push({
      step: "PLAN",
      message: "Execution plan created."
    });

    return plan;
  }

  async execute() {
    this.state.status = "executing";

    this.state.observations.push({
      step: "EXECUTE",
      message: "Execution phase started."
    });

    const execution =
      await this.execution.executePlan(
        this.state.plan
      );

    this.state.execution = execution;

    if (execution.success) {
      this.state.observations.push({
        step: "EXECUTE",
        message: "Execution completed successfully."
      });
    } else {
      this.state.observations.push({
        step: "EXECUTE_ERROR",
        message:
          "Execution stopped because an action failed."
      });
    }

    return execution;
  }

  async verify() {
    this.state.status = "verifying";

    this.state.observations.push({
      step: "VERIFY",
      message: "Verification phase started."
    });

    const repository =
      await this.verification.verifyRepository();

    const plan =
      await this.verification.verifyPlan(
        this.state.plan
      );

    const success =
      repository.success &&
      plan.success;

    this.state.verification = {
      success,
      repository,
      plan
    };

    this.state.observations.push({
      step: "VERIFY",
      message: success
        ? "Verification completed successfully."
        : "Verification detected a problem."
    });

    return this.state.verification;
  }

  async run(prompt) {
    const task =
      String(prompt || "").trim();

    if (!task) {
      throw new Error("EMPTY_TASK");
    }

    this.state = {
      ...this.createInitialState(),
      status: "analyzing",
      task
    };

    // STEP 1
    this.state.observations.push({
      step: "UNDERSTAND",
      message:
        "Task received and normalized."
    });

    // STEP 2
    this.state.status = "inspecting";
    await this.inspect();

    // STEP 3
    this.state.status = "planning";
    await this.createPlan(task);

    // STEP 4
    if (
      this.agent.config.requirePlanBeforeWrite
    ) {
      this.state.observations.push({
        step: "EXECUTION_GATE",
        message:
          "Plan approved internally for controlled execution."
      });
    }

    // STEP 5
    await this.execute();

    // STEP 6
    await this.verify();

    if (
      this.state.execution?.success &&
      this.state.verification?.success
    ) {
      this.state.status = "completed";

      this.state.result = {
        mode: "EXECUTED_AGENT",
        success: true,
        message:
          "Task executed and verified successfully."
      };
    } else {
      this.state.status = "failed";

      this.state.result = {
        mode: "EXECUTED_AGENT",
        success: false,
        message:
          "Task execution or verification failed.",
        nextAction:
          "Inspect the execution and verification results before retrying."
      };
    }

    return this.state;
  }

  getState() {
    return structuredClone(this.state);
  }

  reset() {
    this.state =
      this.createInitialState();
  }
}
